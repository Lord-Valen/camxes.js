{
  "name": "camxes.js",
  "version": "0.0.3",
  "description": "A Lojban parser.",
  "author": "Lord-Valen",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "packageManager": "pnpm@10.12.0",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "dts": true,
    "clean": true,
    "publicDir": true
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.3",
    "eslint": "^9.29.0",
    "tsup": "^8.5.0",
    "turbo": "^2.5.4",
    "typescript": "5.8.x",
    "typescript-eslint": "^8.34.1"
  },
  "dependencies": {
    "pegjs": "^0.7.0"
  }
}